{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/win-x64/CodexUsageCompanion.exe\" --session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/win-x64/CodexUsageCompanion.exe\" --refresh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
